{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client"],

    // The @amplib packages are vendored rather than installed, for now: they
    // live in a monorepo that is not yet published to npm, and npm cannot
    // depend on a subdirectory of a git repository.
    //
    // This is a bridge, not the destination. Imports already use the published
    // specifiers, so when public-library publishes, the migration is npm
    // install plus deleting these paths, the vite aliases and vendor/ — not a
    // single import statement changes.
    "baseUrl": ".",
    "paths": {
      "@amplib/sound-synthesis": ["./vendor/amplib-sound-synthesis/index.d.ts"],
      "@amplib/hue-wheel": ["./vendor/amplib-hue-wheel/index.d.ts"],
      "@amplib/music-theory": ["./vendor/amplib-music-theory/index.d.ts"]
    }
  },
  "include": ["src/**/*", "controller/**/*"]
}
